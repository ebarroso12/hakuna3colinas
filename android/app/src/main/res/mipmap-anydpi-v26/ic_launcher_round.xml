<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone adaptativo (Android 8.0 / API 26+).

  Vive em `mipmap-anydpi-v26/` e NAO em `drawable/`: o manifest aponta para
  `@mipmap/ic_launcher`, e e o sufixo `-anydpi-v26` que faz o Android 8+
  preferir este XML e o Android 7 e anterior cair nos PNG de
  `mipmap-*dpi/`. A especificacao pedia os arquivos em `drawable/`, onde
  eles nunca seriam usados como icone do app.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
